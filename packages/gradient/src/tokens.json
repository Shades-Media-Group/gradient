{
  "$description": "Gradient tokens, the single source for tokens.css, theme.css and tokens.json. DTCG format. Semantic tokens carry their dark value in $extensions.md.shades.gradient.dark.",
  "color": {
    "red": {
      "$type": "color",
      "$description": "Shades Red. 500 is the logo red, taken from the shades.md logo file.",
      "50": { "$value": "#FFF0F2" },
      "100": { "$value": "#FFDDE2" },
      "200": { "$value": "#FFC4CF" },
      "300": { "$value": "#FF8299" },
      "400": { "$value": "#F23D57" },
      "500": { "$value": "#E40523" },
      "600": { "$value": "#C4041E" },
      "700": { "$value": "#AB000D" },
      "800": { "$value": "#7E000A" },
      "900": { "$value": "#550007" }
    },
    "ink": {
      "$type": "color",
      "$description": "The neutral spine, from ink to paper.",
      "950": { "$value": "#0A0A0B" },
      "900": { "$value": "#141416" },
      "800": { "$value": "#1C1C20" },
      "700": { "$value": "#26262E" },
      "600": { "$value": "#3A3A40" },
      "500": { "$value": "#56565E" },
      "400": { "$value": "#6B6B73" },
      "300": { "$value": "#9A9AA2" },
      "200": { "$value": "#C8C8CD" },
      "100": { "$value": "#E6E6E4" },
      "50": { "$value": "#F3F3F1" },
      "0": { "$value": "#FDFDFC", "$description": "Paper." }
    },
    "spectrum": {
      "$type": "color",
      "$description": "The four shades of the Gradient, blue to orange. Used together only as the spectrum strip.",
      "blue": { "$value": "#6364FF" },
      "magenta": { "$value": "#D212D6" },
      "red": { "$value": "{color.red.500}" },
      "orange": { "$value": "#FF5900" }
    },
    "family": {
      "$type": "color",
      "$description": "Body colours of the Spectra family. Character art only, never interface chrome.",
      "spectra": { "$value": "{color.red.500}" },
      "mera": { "$value": "#6364FF" },
      "sol": { "$value": "#FF5900" },
      "nova": { "$value": "#FF1CAE" },
      "sage": { "$value": "#00A96E" },
      "vio": { "$value": "#D212D6" },
      "sunny": { "$value": "#FF9A00" }
    }
  },
  "role": {
    "$type": "color",
    "$description": "What an interface uses. Client themes override these, never the primitives.",
    "bg": { "$value": "{color.ink.0}", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.950}" } } },
    "surface": { "$value": "#FFFFFF", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.900}" } } },
    "sunken": { "$value": "{color.ink.50}", "$extensions": { "md.shades.gradient": { "dark": "#0E0E10" } } },
    "line": { "$value": "{color.ink.100}", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.700}" } } },
    "line-strong": { "$value": "{color.ink.200}", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.600}" } } },
    "text": { "$value": "{color.ink.950}", "$extensions": { "md.shades.gradient": { "dark": "#F5F5F3" } } },
    "text-2": { "$value": "{color.ink.600}", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.200}" } } },
    "text-3": { "$value": "{color.ink.400}", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.300}" } } },
    "accent": { "$value": "{color.red.500}", "$extensions": { "md.shades.gradient": { "dark": "{color.red.500}" } } },
    "accent-hover": { "$value": "{color.red.600}", "$extensions": { "md.shades.gradient": { "dark": "{color.red.600}" } } },
    "accent-press": { "$value": "{color.red.700}", "$extensions": { "md.shades.gradient": { "dark": "{color.red.700}" } } },
    "accent-text": { "$value": "#D10420", "$extensions": { "md.shades.gradient": { "dark": "#FF5C70" } } },
    "accent-soft": { "$value": "{color.red.50}", "$extensions": { "md.shades.gradient": { "dark": "#2A0A0F" } } },
    "on-accent": { "$value": "#FFFFFF", "$extensions": { "md.shades.gradient": { "dark": "#FFFFFF" } } },
    "inverse": { "$value": "{color.ink.950}", "$extensions": { "md.shades.gradient": { "dark": "#F5F5F3" } } },
    "on-inverse": { "$value": "{color.ink.0}", "$extensions": { "md.shades.gradient": { "dark": "{color.ink.950}" } } },
    "success": { "$value": "#00804F", "$extensions": { "md.shades.gradient": { "dark": "#3CCF97" } } },
    "warning": { "$value": "#9A5B00", "$extensions": { "md.shades.gradient": { "dark": "#F5B04A" } } },
    "danger": { "$value": "#C4041E", "$extensions": { "md.shades.gradient": { "dark": "#FF5C70" } } }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Space Grotesk Variable", "Space Grotesk", "Inter Variable", "system-ui", "sans-serif"],
      "$description": "Headlines and the wordmark. Weights 500 to 700."
    },
    "body": {
      "$value": ["Hanken Grotesk Variable", "Hanken Grotesk", "Inter Variable", "system-ui", "-apple-system", "Segoe UI", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", "sans-serif"],
      "$description": "Everything else. Inter covers Cyrillic, which Hanken and Space Grotesk lack."
    },
    "code": {
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
      "$description": "Code the reader types. Never numbers, labels or metadata."
    }
  },
  "text": {
    "$type": "dimension",
    "$description": "Font sizes. Display sizes scale with the viewport.",
    "display": { "$value": "clamp(3.5rem, 2rem + 6.4vw, 8rem)" },
    "title": { "$value": "clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem)" },
    "h1": { "$value": "clamp(2rem, 1.6rem + 1.6vw, 3rem)" },
    "h2": { "$value": "1.75rem" },
    "h3": { "$value": "1.375rem" },
    "lead": { "$value": "clamp(1.1875rem, 1.05rem + 0.6vw, 1.5rem)" },
    "body": { "$value": "1.0625rem" },
    "small": { "$value": "0.9375rem" },
    "caption": { "$value": "0.8125rem" }
  },
  "leading": {
    "$type": "number",
    "display": { "$value": 0.92 },
    "title": { "$value": 0.98 },
    "heading": { "$value": 1.1 },
    "body": { "$value": 1.55 }
  },
  "tracking": {
    "$type": "dimension",
    "display": { "$value": "-0.04em" },
    "title": { "$value": "-0.03em" },
    "heading": { "$value": "-0.015em" },
    "body": { "$value": "0em" }
  },
  "space": {
    "$type": "dimension",
    "$description": "A 4 px base. Steps 1 to 10.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" },
    "9": { "$value": "6rem" },
    "10": { "$value": "8rem" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "The mark is square; actions are pills. Nothing in between is decorative.",
    "none": { "$value": "0" },
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "20px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgb(10 10 11 / 0.06), 0 2px 6px -2px rgb(10 10 11 / 0.10)" },
    "md": { "$value": "0 2px 4px rgb(10 10 11 / 0.06), 0 12px 28px -12px rgb(10 10 11 / 0.22)" },
    "lg": { "$value": "0 4px 8px rgb(10 10 11 / 0.06), 0 32px 64px -24px rgb(10 10 11 / 0.32)" },
    "accent": { "$value": "0 10px 24px -10px rgb(228 5 35 / 0.6)", "$description": "Only under the one primary action." }
  },
  "duration": {
    "$type": "duration",
    "snap": { "$value": "180ms", "$description": "Hovers, toggles, chips. Never bounces." },
    "pop": { "$value": "320ms", "$description": "Entrances and reactions. One overshoot." },
    "move": { "$value": "480ms", "$description": "Things that travel: panels, reveals." },
    "loop": { "$value": "3600ms", "$description": "Ambient idles, mascots only." }
  },
  "ease": {
    "$type": "cubicBezier",
    "snap": { "$value": [0.2, 0, 0, 1] },
    "pop": { "$value": [0.34, 1.56, 0.64, 1] },
    "move": { "$value": [0.22, 1, 0.36, 1], "$description": "The house curve." }
  }
}
